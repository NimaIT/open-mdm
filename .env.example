# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=MDM Platform
ENVIRONMENT=production          # development | production (production marks cookies Secure)
DEBUG=false
# REQUIRED: generate with `openssl rand -base64 48`
SECRET_KEY=CHANGE-ME-generate-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=480

# ─── Observability / structured logging (AO-1) ────────────────────────────────
LOG_JSON=false                  # true = one JSON object per line (ELK/Splunk); false = human-readable text
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR (DEBUG=true forces DEBUG)
LOG_STREAM_FILES=false          # also write each stream to its own rotating JSON file
# LOG_DIR=/var/log/mdm          # required when LOG_STREAM_FILES=true; files: platform.log / integration.log / custom.log

# ─── Target PostgreSQL cluster ────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=mdm
PGSSLMODE=require               # disable | prefer | require | verify-ca | verify-full

# Runtime role — DML only. Used for every request.
PGUSER=mdm_app
PGPASSWORD=

# Elevated role — used ONLY when publishing models / provisioning.
# Falls back to PGUSER/PGPASSWORD if unset.
PG_DDL_USER=mdm_ddl
PG_DDL_PASSWORD=

# Database used for CREATE DATABASE (cannot run inside the target database)
PG_MAINTENANCE_DATABASE=postgres

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ─── Schema names ─────────────────────────────────────────────────────────────
# Change only if these collide with existing schemas.
SCHEMA_META=mdm_meta
SCHEMA_LANDING=mdm_landing
SCHEMA_STAGING=mdm_staging
SCHEMA_LIVE=mdm
SCHEMA_HISTORY=mdm_history

# ─── LDAP / Active Directory ──────────────────────────────────────────────────
LDAP_ENABLED=false
LDAP_SERVER=ldaps://dc01.corp.example.com:636
LDAP_USE_SSL=true               # true for ldaps:// on 636
LDAP_START_TLS=false            # true for ldap:// on 389 with StartTLS
LDAP_TLS_VERIFY=true
# LDAP_CA_CERT_FILE=/etc/ssl/certs/corp-ca.pem

# Service account used to search the directory
LDAP_BIND_DN=CN=svc_mdm,OU=Service Accounts,DC=corp,DC=example,DC=com
LDAP_BIND_PASSWORD=

LDAP_BASE_DN=DC=corp,DC=example,DC=com
# LDAP_USER_SEARCH_BASE=OU=Users,DC=corp,DC=example,DC=com
# LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=corp,DC=example,DC=com

# {username} is substituted, RFC 4515-escaped
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_NESTED_GROUPS=true         # resolve nested AD groups transitively
LDAP_TIMEOUT_SECONDS=10

# Bootstrap group→role mapping. Manage these in the UI once you can sign in.
# LDAP_ADMIN_GROUP_DN=CN=MDM_Admins,OU=Groups,DC=corp,DC=example,DC=com
# LDAP_STEWARD_GROUP_DN=CN=MDM_Stewards,OU=Groups,DC=corp,DC=example,DC=com
# LDAP_READER_GROUP_DN=CN=MDM_Readers,OU=Groups,DC=corp,DC=example,DC=com

# ─── Break-glass admin ────────────────────────────────────────────────────────
# Keep this enabled: it is how you get in when the directory is unreachable.
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USERNAME=admin
# Leave blank to have one generated and printed to the startup log once.
LOCAL_ADMIN_PASSWORD=

# ─── Governance behaviour ─────────────────────────────────────────────────────
# Blocks a steward from approving a record they submitted or last edited.
ENFORCE_SEGREGATION_OF_DUTIES=true
# Global guard on column drops / type narrowing. Per-request confirmation is
# still required even when this is true.
ALLOW_DESTRUCTIVE_DDL=false
# Validate landing→staging inline on write. Set false for high write volume and
# drive POST /stewardship/{entity}/promote from a scheduler instead.
AUTO_PROMOTE_LANDING=true
SOFT_DELETE=true
MAX_BULK_ROWS=10000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://mdm.corp.example.com
